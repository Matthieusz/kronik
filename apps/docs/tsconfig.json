{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "composite": true,
    "incremental": true,
    "types": ["bun"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
