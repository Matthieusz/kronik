{
  "name": "kronik",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.6",
      "@effect/platform-bun": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/vitest": "4.0.6",
      "tsrs": "0.20.0-ts7.1.0-beta",
      "alchemy": "2.0.0-beta.84",
      "@alchemy.run/cloudflare": "2.0.0-beta.84"
    }
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev": "bun alchemy dev",
    "deploy": "bun alchemy deploy --stage prod",
    "plan": "bun alchemy plan --stage prod",
    "destroy": "bun alchemy destroy",
    "logs": "bun alchemy logs",
    "tail": "bun alchemy tail",
    "lint": "oxlint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test:integration": "bun run --cwd apps/api test:integration",
    "verify": "bun run format:check && bun run lint && bun run --cwd packages/contract typecheck && bun run --cwd packages/contract test && bun run --cwd packages/contract openapi:check && bun run --cwd apps/api typecheck && bun run --cwd apps/api test && bun run --cwd apps/api test:integration && bun run --cwd apps/docs typecheck && bun run --cwd apps/docs test && bun run --cwd apps/docs build && bun run --cwd apps/docs validate",
    "check": "bun run verify",
    "postinstall": "effect-tsgo patch --no-typescript --tsrs --oxlint"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.59.0",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
