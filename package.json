{
  "name": "kronik",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.0-beta.103",
      "@effect/platform-bun": "4.0.0-beta.103",
      "@effect/platform-node": "4.0.0-beta.103",
      "@effect/vitest": "4.0.0-beta.103",
      "typescript": "7.0.2",
      "alchemy": "2.0.0-beta.67"
    }
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run --filter '*' test && bun run --cwd packages/contract openapi:check",
    "postinstall": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.32.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
