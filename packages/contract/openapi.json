          "404": {
            "description": "UserNotFoundProblem | LatestCommitNotFoundProblem",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/UserNotFoundProblem"
                    },
                    {
                      "$ref": "#/components/schemas/LatestCommitNotFoundProblem"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "RateLimitedProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedProblem"
                }
              }
            }
          },
          "502": {
            "description": "UpstreamFailureProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamFailureProblem"
                }
              }
            }
          },
          "503": {
            "description": "ServiceUnavailableProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableProblem"
                }
              }
            }
          }
        },
        "description": "Return the most recently committed matching public default-branch commit.",
        "summary": "Get the latest public commit"
      }
    },
    "/v1/users/{username}/activity": {
