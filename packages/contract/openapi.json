{
  "openapi": "3.1.0",
  "info": {
    "title": "Kronik API",
    "version": "1.0.0",
    "description": "Portfolio-friendly summaries of a GitHub user's public development activity."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "health.get",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "description": "Report Worker liveness without probing GitHub.",
        "summary": "Check Kronik health"
      }
    },
    "/v1/users/{username}/commits": {
      "get": {
        "tags": [
          "Activity"
        ],
        "operationId": "v1.activity.commits",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/GitHubUsername"
            },
            "required": true
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Cursor"
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "CommitPage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitPage"
                }
              }
            }
          },
          "400": {
            "description": "InvalidRequestProblem | InvalidCursorProblem",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/InvalidRequestProblem"
                    },
                    {
                      "$ref": "#/components/schemas/InvalidCursorProblem"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "UserNotFoundProblem | LatestCommitNotFoundProblem",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/UserNotFoundProblem"
                    },
                    {
                      "$ref": "#/components/schemas/LatestCommitNotFoundProblem"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "RateLimitedProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedProblem"
                }
              }
            }
          },
          "502": {
            "description": "UpstreamFailureProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamFailureProblem"
                }
              }
            }
          },
          "503": {
            "description": "ServiceUnavailableProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableProblem"
                }
              }
            }
          }
        },
        "description": "List default-branch commits whose primary author GitHub resolves to the requested user. Initial requests default to ten items; continuation requests use only an opaque cursor.",
        "summary": "List public commits",
        "x-codeSamples": [
          {
            "id": "initial",
            "lang": "bash",
            "label": "Initial request",
            "source": "curl 'https://api.example.com/v1/users/octocat/commits?limit=25'"
          },
          {
            "id": "continuation",
            "lang": "bash",
            "label": "Continuation request",
            "source": "curl 'https://api.example.com/v1/users/octocat/commits?cursor=CURSOR_FROM_PREVIOUS_RESPONSE'"
          }
        ]
      }
    },
