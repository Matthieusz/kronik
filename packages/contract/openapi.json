          },
          "429": {
            "description": "RateLimitedProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedProblem"
                }
              }
            }
          },
          "502": {
            "description": "UpstreamFailureProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamFailureProblem"
