              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/InvalidRequestProblem"
                    },
                    {
                      "$ref": "#/components/schemas/InvalidCursorProblem"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "UserNotFoundProblem | LatestCommitNotFoundProblem",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/UserNotFoundProblem"
